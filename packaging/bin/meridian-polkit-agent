#!/bin/sh
# Starts the first polkit authentication agent that is installed. The agent
# is what asks for your password when a program needs administrator rights
# (pkexec, package managers, disk tools).
for agent in \
    /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 \
    /usr/lib/polkit-kde-authentication-agent-1 \
    /usr/lib/hyprpolkitagent/hyprpolkitagent \
    /usr/lib/mate-polkit/polkit-mate-authentication-agent-1 \
    /usr/bin/lxqt-policykit-agent
do
    [ -x "$agent" ] && exec "$agent"
done
echo "meridian-polkit-agent: no polkit agent installed (try: pacman -S polkit-gnome)" >&2
# Exit code 0 so systemd does not keep restarting us for nothing.
exit 0
