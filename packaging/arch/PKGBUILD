# Maintainer: The Meridian contributors
#
# Builds Meridian from the git checkout this file lives in:
#
#   cd packaging/arch && makepkg -si
#
# Once the project has a public repository this becomes a normal `meridian-git`
# AUR package with a `source=("git+https://...")` line.

pkgname=meridian-git
pkgver=0.15.0
pkgrel=1
pkgdesc="The Terra desktop: a Wayland compositor, bar, dock, launcher, settings and lock screen in Rust"
arch=('x86_64' 'aarch64')
url="https://github.com/BrentWebBE/Meridian"
license=('MIT')
depends=('cairo' 'dbus' 'gcc-libs' 'glibc' 'glib2' 'gtk4' 'gtk4-layer-shell' 'libdrm' 'libglvnd' 'libinput'
         'libxkbcommon' 'mesa' 'pam' 'pango' 'wl-clip-persist' 'xdg-desktop-portal'
         'xdg-desktop-portal-gtk' 'seatd' 'systemd-libs' 'wayland' 'adwaita-icon-theme')
makedepends=('cargo' 'git')
optdepends=('foot: terminal opened by the default Mod+Return binding'
            'xwayland-satellite: run X11 apps'
            'polkit-gnome: password prompts for administrator actions'
            'gnome-keyring: password storage for apps'
            'pipewire-pulse: sound for apps that use PulseAudio'
            'qt5-wayland: Qt 5 apps on Wayland'
            'qt6-wayland: Qt 6 apps on Wayland'
            'nautilus: file manager opened by the desktop icons'
            'wireplumber: volume icon in the bar (wpctl)'
            'libnotify: notify-send, for testing notifications'
            'alacritty: alternative terminal')
# Keep local changes to the lock screen's PAM rules on upgrade.
backup=('etc/pam.d/meridian-lock')
provides=('meridian')
conflicts=('meridian')
# Rust handles LTO itself (see [profile.release]); makepkg's C LTO flags only get in the way.
options=('!lto')

# The repository root, two levels above this PKGBUILD.
_repo="$(realpath "${startdir:-$PWD}/../..")"

build() {
  cd "$_repo"
  # --locked: fail instead of silently changing Cargo.lock (the pinned versions).
  cargo build --release --locked
}

check() {
  cd "$_repo"
  cargo test --release --locked
}

package() {
  cd "$_repo"
  for bin in meridian-comp meridian-bar meridian-dock meridian-launcher meridian-notify meridian-settings \
             meridian-desktop meridian-lock; do
    install -Dm755 "target/release/$bin" "$pkgdir/usr/bin/$bin"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 STABILIZATION.md "$pkgdir/usr/share/doc/$pkgname/STABILIZATION.md"
  # Example configuration (the same file the built-in defaults come from).
  install -Dm644 meridian-common/resources/default-config.toml "$pkgdir/usr/share/doc/$pkgname/config.toml"
  # The three moods' colors, as a template for ~/.config/meridian/themes.toml.
  install -Dm644 meridian-common/resources/themes.toml "$pkgdir/usr/share/doc/$pkgname/themes.toml"
  # How the lock screen checks passwords. Without it meridian-lock refuses to lock.
  install -Dm644 packaging/pam/meridian-lock "$pkgdir/etc/pam.d/meridian-lock"
  # Lets Find and the dock list the Settings app.
  install -Dm644 packaging/applications/org.meridian.Settings.desktop \
    "$pkgdir/usr/share/applications/org.meridian.Settings.desktop"
  # The session: a script for login managers, and systemd user units that
  # run each shell program and restart it if it crashes.
  install -Dm755 packaging/session/meridian-session "$pkgdir/usr/bin/meridian-session"
  install -Dm755 packaging/bin/terra-doctor "$pkgdir/usr/bin/terra-doctor"
  install -Dm755 packaging/bin/meridian-polkit-agent "$pkgdir/usr/bin/meridian-polkit-agent"
  # Selects portal backends for XDG_CURRENT_DESKTOP=Meridian.
  install -Dm644 packaging/portals/meridian-portals.conf \
    "$pkgdir/usr/share/xdg-desktop-portal/meridian-portals.conf"
  install -Dm644 -t "$pkgdir/usr/lib/systemd/user" packaging/systemd/*
  # Makes "Meridian" selectable in login managers such as GDM and SDDM.
  install -Dm644 packaging/session/meridian.desktop "$pkgdir/usr/share/wayland-sessions/meridian.desktop"
}
